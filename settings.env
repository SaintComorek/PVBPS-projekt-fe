# Zdieľané nastavenia živého AI režimu. NEOBSAHUJE TAJOMSTVÁ.
# API kľúč patrí do súboru .env (GROQ_API_KEY=... alebo LLM_API_KEY=...), ktorý má pred týmto súborom prednosť.

# Groq, OpenAI-kompatibilné Chat Completions API
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# gpt-oss je model s uvažovaním: úroveň uvažovania a limit tokenov vrátane uvažovania
LLM_REASONING_EFFORT=medium
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=1

# Ako model volá nástroje: langchain = LangChain ChatOpenAI s nástrojmi @tool, ktoré LangChain zavolá priamo
# (každý tool ide cez bezpečnostnú bránu), native-tools = natívny tool calling cez vlastný HTTP klient,
# json-tools = volania v JSON texte pre modely bez function callingu (napr. Gemma na Ollame)
LLM_TOOL_PROTOCOL=langchain

# JSON režim odpovede sa použije iba s protokolom json-tools
LLM_JSON_MODE=true

# Pri HTTP 429 (limit požiadaviek) počkať podľa hlavičiek Groq a skúsiť znova.
# Bezplatný Groq má pre gpt-oss-120b limit 8000 tokenov za minútu, preto viac pokusov.
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=60

# Pri natívnom tool callingu model často volá nástroje po jednom, potrebuje viac krokov
MAX_AGENT_STEPS=8
